\@writefile{lot}{\contentsline {table}{\numberline {11}{\ignorespaces Case study B. One pass, resolved at $R_2$, three messages and two robots altered, the minimum for a clash that no hard detour can avoid. The two zero counters are consistent: the corridor has no closed lane and no queue, so the counters and the message log measure different quantities and agree.}}{10}{table.caption.16}\protected@file@percent }
\newlabel{tab:caseB}{{11}{10}{Case study B. One pass, resolved at $R_2$, three messages and two robots altered, the minimum for a clash that no hard detour can avoid. The two zero counters are consistent: the corridor has no closed lane and no queue, so the counters and the message log measure different quantities and agree}{table.caption.16}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {6}{\ignorespaces Case study~B in two views: the message-sequence diagram (time on the vertical axis, the robot pair on the horizontal axis, one arrow per protocol message with its type and the cell it concerns) and the repair card. The arrows describe the repair decision: the initiator asks first, the holder grants second, and only the committing arrow changes a schedule.}}{11}{figure.caption.17}\protected@file@percent }
\newlabel{fig:caseB}{{6}{11}{Case study~B in two views: the message-sequence diagram (time on the vertical axis, the robot pair on the horizontal axis, one arrow per protocol message with its type and the cell it concerns) and the repair card. The arrows describe the repair decision: the initiator asks first, the holder grants second, and only the committing arrow changes a schedule}{figure.caption.17}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.5}Parameter sweep}{11}{subsection.8.5}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {12}{\ignorespaces Per-mode means over the $40$ families of the sweep (three tasks per robot, $30\times 30$). Columns: the mean \texttt  {altered\_plan} and \texttt  {altered\_naive} count per event, the sum of costs, the makespan, \emph  {succ.} $=$ the fraction of disruptions repaired within the budget, \emph  {safe} $=$ the families in which \emph  {no} tick of the run produced a validation violation, \emph  {A$^\ast $} $=$ the mean number of space-time searches and \emph  {msgs} the mean number of protocol messages.}}{11}{table.caption.18}\protected@file@percent }
\newlabel{tab:sweep}{{12}{11}{Per-mode means over the $40$ families of the sweep (three tasks per robot, $30\times 30$). Columns: the mean \code {altered\_plan} and \code {altered\_naive} count per event, the sum of costs, the makespan, \emph {succ.} $=$ the fraction of disruptions repaired within the budget, \emph {safe} $=$ the families in which \emph {no} tick of the run produced a validation violation, \emph {A$^\ast $} $=$ the mean number of space-time searches and \emph {msgs} the mean number of protocol messages}{table.caption.18}{}}
\newlabel{fig:sw_bars}{{7a}{12}{altered robots per event, by mode}{figure.caption.19}{}}
\newlabel{sub@fig:sw_bars}{{a}{12}{altered robots per event, by mode}{figure.caption.19}{}}
\newlabel{fig:sw_altered}{{7b}{12}{altered robots as a function of $N$}{figure.caption.19}{}}
\newlabel{sub@fig:sw_altered}{{b}{12}{altered robots as a function of $N$}{figure.caption.19}{}}
\newlabel{fig:sw_cost}{{7c}{12}{sum of costs as a function of $N$}{figure.caption.19}{}}
\newlabel{sub@fig:sw_cost}{{c}{12}{sum of costs as a function of $N$}{figure.caption.19}{}}
\newlabel{fig:sw_rungs}{{7d}{12}{which rungs resolve the passes}{figure.caption.19}{}}
\newlabel{sub@fig:sw_rungs}{{d}{12}{which rungs resolve the passes}{figure.caption.19}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {7}{\ignorespaces The sweep in four views. The gap between the global restart and the local modes in (a)--(b) is the locality result; (c) shows that the cost of locality is a mild increase in travel that grows with $N$; and (d) shows which rung resolved each pass. The two local modes remain on the low rungs, while every pass of the global baseline is a full restart, which accounts for its larger bar. The artefacts also contain a cost heat-map over the $(N, \text  {density})$ grid and a plot of the four altered-agent definitions side by side.}}{12}{figure.caption.19}\protected@file@percent }
\newlabel{fig:sweep}{{7}{12}{The sweep in four views. The gap between the global restart and the local modes in (a)--(b) is the locality result; (c) shows that the cost of locality is a mild increase in travel that grows with $N$; and (d) shows which rung resolved each pass. The two local modes remain on the low rungs, while every pass of the global baseline is a full restart, which accounts for its larger bar. The artefacts also contain a cost heat-map over the $(N, \text {density})$ grid and a plot of the four altered-agent definitions side by side}{figure.caption.19}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.6}Fleet-size and blockage-density scaling}{12}{subsection.8.6}\protected@file@percent }
\newlabel{sec:scaling}{{8.6}{12}{Fleet-size and blockage-density scaling}{subsection.8.6}{}}
\@writefile{lot}{\contentsline {table}{\numberline {13}{\ignorespaces Two scaling sweeps on the open $30\times 30$ warehouse. Columns are as in table~\ref {tab:sweep}, with \emph  {altered} the mean \texttt  {altered\_plan} count per event and $n$ the number of seeds that completed inside the compute budget. Cells with $n<3$ are omitted, which is why the axes stop at $N=30$ and $10\%$ density: the mean repair pass of a large, densely blocked instance grows with $N^{2}$ and with the blockage count, and the remaining cells did not finish in time to be reported.}}{13}{table.caption.20}\protected@file@percent }
\newlabel{tab:scaling}{{13}{13}{Two scaling sweeps on the open $30\times 30$ warehouse. Columns are as in table~\ref {tab:sweep}, with \emph {altered} the mean \code {altered\_plan} count per event and $n$ the number of seeds that completed inside the compute budget. Cells with $n<3$ are omitted, which is why the axes stop at $N=30$ and $10\%$ density: the mean repair pass of a large, densely blocked instance grows with $N^{2}$ and with the blockage count, and the remaining cells did not finish in time to be reported}{table.caption.20}{}}
\newlabel{fig:sc_n}{{8a}{14}{fleet size $N$ at $5\%$ density}{figure.caption.21}{}}
\newlabel{sub@fig:sc_n}{{a}{14}{fleet size $N$ at $5\%$ density}{figure.caption.21}{}}
\newlabel{fig:sc_d}{{8b}{14}{blockage density at $N=20$}{figure.caption.21}{}}
\newlabel{sub@fig:sc_d}{{b}{14}{blockage density at $N=20$}{figure.caption.21}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {8}{\ignorespaces The two scaling sweeps, each in four views (altered robots per event, sum of costs, makespan and repair success rate). In (a) the global restart's altered set and travel cost grow with the fleet, and by $N=30$ it is both the most expensive and the only mode with residual failures, while the two local modes stay near one to three robots per event; in (b) all three modes are flat in blockage density, because density lengthens the searches that the restart must repeat rather than the number of robots a repair touches. Whiskers are $\pm 1$ standard deviation over the seeds of the cell and the success-rate panels are pinned to $[-0.03,1.03]$.}}{14}{figure.caption.21}\protected@file@percent }
\newlabel{fig:scaling}{{8}{14}{The two scaling sweeps, each in four views (altered robots per event, sum of costs, makespan and repair success rate). In (a) the global restart's altered set and travel cost grow with the fleet, and by $N=30$ it is both the most expensive and the only mode with residual failures, while the two local modes stay near one to three robots per event; in (b) all three modes are flat in blockage density, because density lengthens the searches that the restart must repeat rather than the number of robots a repair touches. Whiskers are $\pm 1$ standard deviation over the seeds of the cell and the success-rate panels are pinned to $[-0.03,1.03]$}{figure.caption.21}{}}
