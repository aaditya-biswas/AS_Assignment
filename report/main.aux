\@writefile{lot}{\contentsline {table}{\numberline {8}{\ignorespaces Case study A. Every one of the 24 tasks is delivered, every tick validates, and the repair touched all 12 robots at least once, through eight separate local passes, six of which ended on the negotiation rung. The panel peaks are the five activity counters of the visualisation; none of them is zero, which motivates the use of a congested instance.}}{9}{table.caption.12}\protected@file@percent }
\newlabel{tab:caseA}{{8}{9}{Case study A. Every one of the 24 tasks is delivered, every tick validates, and the repair touched all 12 robots at least once, through eight separate local passes, six of which ended on the negotiation rung. The panel peaks are the five activity counters of the visualisation; none of them is zero, which motivates the use of a congested instance}{table.caption.12}{}}
\@writefile{lof}{\contentsline {figure}{\numberline {5}{\ignorespaces The congested shift at its final tick. The single door of the closed aisle is the dark gap in the wall, the colours of the robots record which of them the repair altered, and the counters in the panel are the ones tabulated above.}}{9}{figure.caption.13}\protected@file@percent }
\newlabel{fig:finalpanel}{{5}{9}{The congested shift at its final tick. The single door of the closed aisle is the dark gap in the wall, the colours of the robots record which of them the repair altered, and the counters in the panel are the ones tabulated above}{figure.caption.13}{}}
\@writefile{lot}{\contentsline {table}{\numberline {9}{\ignorespaces The eight repair passes of case study~A, in execution order. \emph  {plan}, \emph  {path}, \emph  {delayed} and \emph  {naive} are the four altered-agent counts of the pass, \emph  {delay} is the pass's added delay in ticks and \emph  {msgs} is the cumulative number of protocol messages. The first four passes each end with a negotiated grant (the cumulative message count rises); the last two are $R_1$ self-reroutes with no messages.}}{9}{table.caption.14}\protected@file@percent }
\newlabel{tab:passesA}{{9}{9}{The eight repair passes of case study~A, in execution order. \emph {plan}, \emph {path}, \emph {delayed} and \emph {naive} are the four altered-agent counts of the pass, \emph {delay} is the pass's added delay in ticks and \emph {msgs} is the cumulative number of protocol messages. The first four passes each end with a negotiated grant (the cumulative message count rises); the last two are $R_1$ self-reroutes with no messages}{table.caption.14}{}}
\@writefile{toc}{\contentsline {subsection}{\numberline {8.3}Comparison of repair strategies}{9}{subsection.8.3}\protected@file@percent }
\@writefile{lot}{\contentsline {table}{\numberline {10}{\ignorespaces All four repair modes and the no-repair ablation on the identical event list of case study~A. $^{*}$\texttt  {static} is an ablation: repairs are disabled by design, so its violations represent the cost of \emph  {not} repairing. ``altered'' is the number of distinct robots whose plan changed at least once. The negotiated mode is the only strategy that attains the best makespan (128), delivers every task, validates every tick and completes the repair in eight passes.}}{10}{table.caption.15}\protected@file@percent }
\newlabel{tab:compare}{{10}{10}{All four repair modes and the no-repair ablation on the identical event list of case study~A. $^{*}$\code {static} is an ablation: repairs are disabled by design, so its violations represent the cost of \emph {not} repairing. ``altered'' is the number of distinct robots whose plan changed at least once. The negotiated mode is the only strategy that attains the best makespan (128), delivers every task, validates every tick and completes the repair in eight passes}{table.caption.15}{}}
